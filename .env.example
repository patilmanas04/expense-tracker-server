DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
WEBHOOK_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
# Optional; retain your existing working model or choose one available to your account.
GEMINI_MODEL=gemini-3.5-flash-lite

# All Google credentials live on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
DASHBOARD_OWNER_EMAIL=
FRONTEND_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Spend-limit email alerts via the Gmail API (OAuth, gmail.send scope only). See README → Email alerts.
# Client of type "Desktop app"; the refresh token comes from: uv run python scripts/gmail_authorize.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional: where alerts go. Defaults to DASHBOARD_OWNER_EMAIL.
ALERT_EMAIL_TO=
